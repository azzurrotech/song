# =============================================================================
# SONG — environment configuration template
# =============================================================================
# song reads its configuration from command-line flags. For containerized or
# orchestrated deployments the flags fall back to these environment variables,
# so a .env / docker-compose file like this is enough to steer the process:
#
#   docker run -p 8083:8083 \
#     --env-file .env \
#     -v song-data:/data \
#     ghcr.io/azzurrotech/song
#
# CLI flags override these variables. Copy to .env and adjust.

# HTTP port the standalone server listens on
SONG_PORT=8083

# Root directory holding the per-tenant silos (files, .templates, .song/meta.json)
SONG_ROOT=/data

# song needs no secrets: it serves plain static files and renders Go templates
# from each silo's .templates/ directory.